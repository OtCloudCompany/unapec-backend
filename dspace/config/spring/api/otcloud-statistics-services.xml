<!--
    UNAPEC / OTCloud extended usage statistics.

    Deliberately kept in a file of its own rather than added to solr-services.xml: every bean here
    is local customisation, so a DSpace upgrade can replace the upstream Spring configuration
    wholesale without having to re-merge our additions.
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd">

    <context:annotation-config/>

    <bean id="otCloudStatisticsService"
          class="org.dspace.otcloud.statistics.OTCloudStatisticsService"
          autowire-candidate="true"
          lazy-init="true">
        <description>
            Aggregation queries against the usage statistics Solr core, backing the extended
            site, community, collection and item level usage reports.
        </description>
    </bean>

</beans>
